# Copy to .env for local development. On your host (e.g. Render), set these as environment variables instead.

# PostgreSQL connection string, e.g. from Neon (neon.tech): postgres://user:pass@host/db?sslmode=require
DATABASE_URL=

# The public address of the site, no trailing slash. Paystack returns customers here after paying.
SITE_URL=http://localhost:3000

# Paystack → Settings → API Keys & Webhooks. Use the sk_test_ key until you are ready to take real money.
PAYSTACK_SECRET_KEY=

# Admin pages at /admin (username + password, at least 12 characters).
ADMIN_USER=admin
ADMIN_PASSWORD=

# Optional but recommended: email the owner about new paid orders and enquiries via resend.com.
RESEND_API_KEY=
OWNER_EMAIL=
# NOTIFY_FROM=Atmonsur Store <orders@your-domain.com>   (needs your domain verified in Resend)
