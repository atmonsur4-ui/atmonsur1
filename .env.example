# Copy to .env for local development. On your host (e.g. Render), set these as environment variables instead.

# PostgreSQL connection string, e.g. from Neon (neon.tech): postgres://user:pass@host/db?sslmode=require
DATABASE_URL=

# The public address of the site, no trailing slash. PalmPay returns customers here after paying.
SITE_URL=http://localhost:3000

# PalmPay merchant API (docs.palmpay.com). Keys are the base64 text PalmPay shows (PEM also works).
# sandbox until you're ready to take real money, then production (which also needs this server's IP whitelisted at PalmPay).
PALMPAY_ENV=sandbox
# App ID from the PalmPay merchant portal (starts with "L").
PALMPAY_APP_ID=
# YOUR private key; its matching public key is the one you upload to the PalmPay merchant portal. Never share it.
PALMPAY_PRIVATE_KEY=
# PALMPAY's platform public key, from the merchant portal. Used to check payment notifications really come from PalmPay.
PALMPAY_PUBLIC_KEY=

# Admin pages at /admin (username + password, at least 12 characters).
ADMIN_USER=admin
ADMIN_PASSWORD=

# Emails via resend.com: you get new paid orders and enquiries; customers get confirm-email and password-reset links.
# Without these, customers can't reset forgotten passwords.
RESEND_API_KEY=
OWNER_EMAIL=
# Sending to customers needs your own domain verified in Resend:
NOTIFY_FROM=Atmonsur Store <orders@your-domain.com>
